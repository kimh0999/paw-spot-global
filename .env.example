# ─────────────────────────────────────────────
# Database (Supabase + Prisma)
# ─────────────────────────────────────────────

# Runtime queries
# For Vercel/serverless, use Supabase transaction pooler.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations
# Prefer direct connection if available.
# If your network cannot use IPv6, use Supabase session pooler instead.
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

MIGRATE_DATABASE_URL="Session pooler URL, pooler.supabase.com:5432"

# ─────────────────────────────────────────────
# Auth.js v5 (Google OAuth)
# ─────────────────────────────────────────────
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─────────────────────────────────────────────
# Google Maps Platform
# ─────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""

# ─────────────────────────────────────────────
# TourAPI (한국관광공사 공공데이터포털)
# ─────────────────────────────────────────────
TOUR_API_SERVICE_KEY=""

# ─────────────────────────────────────────────
# Sentry
# ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ─────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"