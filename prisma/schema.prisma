generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Category {
  RESTAURANT
  CAFE
  TRAVEL
  ETC
}

enum IndoorPolicy {
  ALLOWED
  OUTDOOR_ONLY
  PARTIAL_AREA
  NOT_ALLOWED
  UNKNOWN
}

enum DogSize {
  SMALL
  MEDIUM
  LARGE
}

enum MaxDogSize {
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

// Retained in schema to prevent Prisma from dropping the DB type.
// No longer used by any model field — remove in a separate migration after verifying safety.
enum CarrierPolicy {
  NOT_REQUIRED
  REQUIRED
  OPTIONAL
  UNKNOWN
}

enum CarrierStrollerPolicy {
  NOT_REQUIRED
  REQUIRED_INDOOR
  REQUIRED_ALWAYS
  UNKNOWN
}

enum LeashPolicy {
  REQUIRED
  NOT_REQUIRED
  PARTIAL_AREA
  UNKNOWN
}

enum MuzzlePolicy {
  REQUIRED
  NOT_REQUIRED
  CONDITIONAL
  UNKNOWN
}

enum VaccinationCertificatePolicy {
  REQUIRED
  NOT_REQUIRED
  UNKNOWN
}

/// 이미지 이용 조건. 공공누리(KOGL) 4개 유형은 모두 **출처 표시**를 요구한다.
/// 유형에 따라 상업적 이용·변형 허용 범위가 달라지므로 값을 뭉뚱그리지 않는다.
/// 확인하지 못했으면 UNKNOWN이다 — "제한 없음"이 아니라 "확인되지 않음"이다.
enum ImageLicenseType {
  KOGL_TYPE1
  KOGL_TYPE2
  KOGL_TYPE3
  KOGL_TYPE4
  UNKNOWN
}

/// 주차 가능 여부. TourAPI `detailIntro2`의 주차 안내를 담을 곳이 없어 추가했다.
/// UNKNOWN은 "주차 불가"가 아니라 **"확인되지 않음"**이다 — 이 프로젝트의 나머지 enum과 같다.
/// 요금·대수 같은 세부는 코드로 닫을 수 없어 `parkingNote` 한 줄로 둔다.
enum ParkingAvailability {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

enum VerificationMethod {
  PHONE
  DM
  WEBSITE
  ON_SITE
  USER_REPORT
}

enum PlaceVisibility {
  VISIBLE
  HIDDEN
  DRAFT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(USER)
  locale    String   @default("en")
  createdAt DateTime @default(now())

  dogs      Dog[]
  favorites Favorite[]
}

model Place {
  id        String   @id @default(cuid())
  tourApiId String?  @unique
  nameKr    String
  nameEn    String?
  category  Category
  address   String

  location Unsupported("geography(Point, 4326)")

  phone        String?
  website      String?
  instagram    String?
  thumbnailUrl String?

  /// 장소 소개. **언어별로 나눈다** — 한국어 원문을 영어 UI에 그대로 내보내면
  /// 영문 설명이 있는 것처럼 보인다. `nameKr`/`nameEn`과 같은 규칙이다.
  /// 가져오기는 이 값을 채우지 않는다. 사람이 검토 시트의 원문을 보고 넣는다.
  descriptionKr String?
  descriptionEn String?

  /// 주차. `UNKNOWN`은 확인되지 않음이다.
  parking     ParkingAvailability @default(UNKNOWN)
  /// 요금·위치 같은 짧은 보조 정보 1줄. 주차 가능 여부 자체를 대신하지 않는다.
  parkingNote String?

  /// 운영·이용 안내 원문. **`hours`로 옮길 수 없는 것**이 여기 남는다 —
  /// 계절별·시설별 시간, `"상시 개방"`, 복잡한 휴무 규칙, 주차 상세.
  /// `hours`가 장소 전체의 요일별 시간만 담기 때문에, 범위가 붙은 안내를 통째로
  /// `hours`에 밀어 넣으면 출렁다리 운영시간이 휴양림 전체 시간이 된다.
  /// `descriptionKr`/`descriptionEn`과 같은 언어 분리 규칙을 따른다.
  usageGuideKr String?
  usageGuideEn String?

  // 요일별 영업시간 (결정 D-04). 형식은 src/lib/places/operating-hours.ts의
  // operatingHoursSchema가 강제한다. 요일 값이 null이면 그날은 휴무다.
  // 자유 텍스트 단독 저장을 금지한다 — 한국어로 적으면 영어 UI에서 읽히지 않는다.
  hours     Json?
  // 브레이크타임·정기휴무 같은 짧은 보조 정보 1줄. 운영시간 본체를 대신하지 않는다.
  hoursNote String?

  visibility PlaceVisibility @default(DRAFT)

  condition        PlaceCondition?
  imageAttribution PlaceImageAttribution?
  verifications    Verification[]
  favorites        Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([visibility])
}

model PlaceCondition {
  id      String @id @default(cuid())
  placeId String @unique
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  indoor                       IndoorPolicy
  carrierStrollerPolicy        CarrierStrollerPolicy        @default(UNKNOWN)
  maxDogSize                   MaxDogSize                   @default(UNKNOWN)
  leash                        LeashPolicy                  @default(UNKNOWN)
  muzzle                       MuzzlePolicy                 @default(UNKNOWN)
  vaccinationCertificatePolicy VaccinationCertificatePolicy @default(UNKNOWN)
  breedRestrictions            String?
  requiredItems                String[]
  cautions                     String?

  // 컬럼으로 표현할 수 없는 복합 이용수칙 — 준비물의 AND/OR, 매장 내 상태,
  // 공간 예외, 행동 제한, 요금, 위생 수칙, 항목별 불확실성.
  // 형식은 src/lib/places/policy-details.ts의 policyDetailsSchema가 강제한다.
  policyDetails Json?

  updatedAt DateTime @updatedAt
}

/// 대표 이미지의 출처 기록 (결정 D-22).
///
/// **이미지 1장에 대한 기록이다.** `Place`에 컬럼으로 붙이지 않는 이유는 두 가지다 —
/// (a) 사람이 검토했는지를 이미지와 함께 묶어야 하고,
/// (b) 관리자가 `thumbnailUrl`을 바꾸면 이 기록이 더 이상 그 이미지를 설명하지 않는다.
/// `imageUrl`이 현재 `Place.thumbnailUrl`과 다르면 기록은 승계되지 않고 버려진 것으로 읽는다
/// (`VetVerification.verifiedValue`와 같은 스냅샷 장치다).
///
/// 행이 없으면 "출처 조건이 없는 이미지"다. 관리자가 직접 넣은 기존 이미지에
/// 확인하지 않은 출처를 붙이지 않기 위해, 행을 만들지 않는 것이 기본값이다.
model PlaceImageAttribution {
  id      String @id @default(cuid())
  placeId String @unique
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  /// 이 기록이 설명하는 이미지 주소. `Place.thumbnailUrl`과 일치할 때만 유효하다.
  imageUrl String

  /// 공공누리 표기의 기관명. TourAPI를 거친 이미지는 `한국관광공사`다.
  provider String
  /// 저작권자(작성자). **확인되지 않으면 NULL로 둔다** — 기관명으로 대신 채우지 않는다.
  copyrightHolder String?
  /// 저작물명. 장소 이름과 다를 수 있어 별도로 둔다. 확인되지 않으면 NULL이다.
  workTitle String?
  /// 작성연도. 확인되지 않으면 NULL이다. 수집 연도로 대신 채우지 않는다.
  createdYear Int?

  /// 출처 웹사이트 링크. **serviceKey가 들어간 API 요청 URL을 넣지 않는다.**
  sourceUrl  String
  licenseType ImageLicenseType @default(UNKNOWN)
  /// 이용 조건 안내 링크(공공누리 유형 페이지 등).
  licenseUrl String?

  /// 사람이 실제 이미지와 출처·렌더링을 확인한 기록.
  /// **NULL이면 공개 화면에 이미지를 내보내지 않는다.** 코드 생성만으로 채우지 않는다.
  reviewedBy String?
  reviewedAt DateTime?

  /// 원본 추적. 로컬 파일(`data/tour-api/`)을 지워도 어디서 왔는지가 남아야 한다.
  /// `sourceFetchedAt`은 **API 수집 시각**이며 정책을 확인한 날이 아니다.
  preparationId        String?
  sourceSnapshotSha256 String?
  sourceFetchedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Verification {
  id         String             @id @default(cuid())
  placeId    String
  place      Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)
  verifiedBy String
  method     VerificationMethod
  verifiedAt DateTime
  note       String?

  // 확인 당시의 안내문 원문 스냅샷. PlaceCondition에는 현재 공개 중인 구조화 값만 두고,
  // 원문은 여기에 확인 시점 단위로 쌓아 정책이 바뀌어도 과거 근거가 남게 한다.
  // 한·영이 병기된 안내문은 쪼개지 않고 통째로 보존하며 원문의 오타도 고치지 않는다.
  rawPolicyText   String?
  sourceLanguages String[] @default([])
  sourceUrl       String?

  createdAt DateTime @default(now())

  @@index([placeId])
}

model Dog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  size        DogSize
  // Superseded by breedCode/breedCustom — kept so the original input survives the backfill.
  // Drop in a separate migration after read/write on the new fields is verified.
  breed       String?
  breedCode   String?
  breedCustom String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// 동물병원 (결정 D-16)
//
// Place와 분리된 도메인이다. Category에 VET을 더하지 않는 이유는 세 가지다.
//   (a) Place.location이 non-null이라 좌표를 확보하지 못한 병원을 담을 수 없다.
//   (b) Verification.placeId가 필수 FK라 항목별 확인 기록을 붙일 수 없다.
//   (c) VET이 Category에 들어오면 홈 카테고리 탭·filterPlaces·resolveDogAccess·
//       반려견 입장 판정에 그대로 흘러든다. 병원은 동반 조건 판정 대상이 아니다.
// PlaceVisibility·VerificationMethod는 도메인 중립이라 그대로 재사용한다.
// ─────────────────────────────────────────────────────────────

/// 병원이 제공한다고 확인된 서비스의 상태. UNKNOWN은 "없음"이 아니라 "확인되지 않음"이다.
enum VetServiceStatus {
  AVAILABLE
  CONDITIONAL
  UNAVAILABLE
  UNKNOWN
}

/// 확인 근거가 붙는 항목. 주소를 고쳤다고 영어 응대 확인일이 갱신되지 않게 나눈다(D-17).
enum VetVerificationTarget {
  BASIC
  HOURS
  ENGLISH_SUPPORT
  AFTER_HOURS
}

model VetClinic {
  id       String  @id @default(cuid())
  nameKr   String
  /// 병원이 실제로 쓰는 공식 영문명만 넣는다. 자동 번역하지 않는다.
  nameEn   String?
  /// 대전 자치구. 값 목록은 src/lib/vets/constants.ts가 강제한다.
  district String
  address  String
  phone    String

  /// Place와 달리 **nullable**이다. 좌표를 확보하지 못해도 검색·연락은 가능해야 한다.
  /// 좌표가 없으면 거리를 만들지 않고 거리순에서 뒤로 보낸다.
  location Unsupported("geography(Point, 4326)")?

  website String?

  /// 안내된 진료시간. Place.hours와 같은 스키마를 쓴다(operating-hours.ts).
  /// NULL은 "휴무"가 아니라 "아직 입력되지 않음"이다.
  hours     Json?
  hoursNote String?

  /// 영어 응대. CONDITIONAL이면 조건 문구가 함께 있어야 한다.
  englishSupport          VetServiceStatus @default(UNKNOWN)
  englishSupportCondition String?

  /// 야간·응급 진료 운영. 병원명의 "24시"만으로 AVAILABLE로 두지 않는다.
  afterHours          VetServiceStatus @default(UNKNOWN)
  afterHoursCondition String?

  visibility PlaceVisibility @default(DRAFT)

  /// 관리자 내부 메모. 사용자 화면 조회에서 제외한다.
  adminNote   String?
  /// 데이터를 수집한 날. 정보 수정일(updatedAt)·실제 확인일(verifiedAt)과 구분한다.
  collectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications VetVerification[]

  @@index([visibility])
  @@index([district])
}

model VetVerification {
  id         String                @id @default(cuid())
  clinicId   String
  clinic     VetClinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  target     VetVerificationTarget
  method     VerificationMethod
  verifiedBy String
  verifiedAt DateTime
  sourceUrl  String?
  note       String?

  /// 이 기록이 확인한 **값의 스냅샷**(D-17).
  /// 값이 바뀌면 현재 값과 달라지므로 이 기록은 더 이상 그 값을 검증하지 않는다.
  /// 옛 값의 확인 기록이 새 값을 검증한 것처럼 보이는 것을 막는 장치다.
  verifiedValue String?

  createdAt DateTime @default(now())

  @@index([clinicId, target])
}
