generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Category {
  RESTAURANT
  CAFE
  TRAVEL
  ETC
}

enum IndoorPolicy {
  ALLOWED
  OUTDOOR_ONLY
  PARTIAL_AREA
  NOT_ALLOWED
  UNKNOWN
}

enum DogSize {
  SMALL
  MEDIUM
  LARGE
}

enum MaxDogSize {
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

// Retained in schema to prevent Prisma from dropping the DB type.
// No longer used by any model field — remove in a separate migration after verifying safety.
enum CarrierPolicy {
  NOT_REQUIRED
  REQUIRED
  OPTIONAL
  UNKNOWN
}

enum CarrierStrollerPolicy {
  NOT_REQUIRED
  REQUIRED_INDOOR
  REQUIRED_ALWAYS
  UNKNOWN
}

enum LeashPolicy {
  REQUIRED
  NOT_REQUIRED
  PARTIAL_AREA
  UNKNOWN
}

enum MuzzlePolicy {
  REQUIRED
  NOT_REQUIRED
  CONDITIONAL
  UNKNOWN
}

enum VaccinationCertificatePolicy {
  REQUIRED
  NOT_REQUIRED
  UNKNOWN
}

enum VerificationMethod {
  PHONE
  DM
  WEBSITE
  ON_SITE
  USER_REPORT
}

enum PlaceVisibility {
  VISIBLE
  HIDDEN
  DRAFT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(USER)
  locale    String   @default("en")
  createdAt DateTime @default(now())

  dogs      Dog[]
  favorites Favorite[]
}

model Place {
  id           String          @id @default(cuid())
  tourApiId    String?         @unique
  nameKr       String
  nameEn       String?
  category     Category
  address      String

  location     Unsupported("geography(Point, 4326)")

  phone        String?
  website      String?
  instagram    String?
  thumbnailUrl String?

  visibility   PlaceVisibility @default(DRAFT)

  condition     PlaceCondition?
  verifications Verification[]
  favorites     Favorite[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([visibility])
}

model PlaceCondition {
  id                    String                @id @default(cuid())
  placeId               String                @unique
  place                 Place                 @relation(fields: [placeId], references: [id], onDelete: Cascade)

  indoor                IndoorPolicy
  carrierStrollerPolicy CarrierStrollerPolicy @default(UNKNOWN)
  maxDogSize            MaxDogSize            @default(UNKNOWN)
  leash                 LeashPolicy           @default(UNKNOWN)
  muzzle                        MuzzlePolicy                    @default(UNKNOWN)
  vaccinationCertificatePolicy  VaccinationCertificatePolicy    @default(UNKNOWN)
  breedRestrictions             String?
  requiredItems                 String[]
  cautions                      String?

  // 컬럼으로 표현할 수 없는 복합 이용수칙 — 준비물의 AND/OR, 매장 내 상태,
  // 공간 예외, 행동 제한, 요금, 위생 수칙, 항목별 불확실성.
  // 형식은 src/lib/places/policy-details.ts의 policyDetailsSchema가 강제한다.
  policyDetails                 Json?

  updatedAt             DateTime              @updatedAt
}

model Verification {
  id          String             @id @default(cuid())
  placeId     String
  place       Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)
  verifiedBy  String
  method      VerificationMethod
  verifiedAt  DateTime
  note        String?

  // 확인 당시의 안내문 원문 스냅샷. PlaceCondition에는 현재 공개 중인 구조화 값만 두고,
  // 원문은 여기에 확인 시점 단위로 쌓아 정책이 바뀌어도 과거 근거가 남게 한다.
  // 한·영이 병기된 안내문은 쪼개지 않고 통째로 보존하며 원문의 오타도 고치지 않는다.
  rawPolicyText   String?
  sourceLanguages String[]           @default([])
  sourceUrl       String?

  createdAt   DateTime           @default(now())

  @@index([placeId])
}

model Dog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  size        DogSize
  // Superseded by breedCode/breedCustom — kept so the original input survives the backfill.
  // Drop in a separate migration after read/write on the new fields is verified.
  breed       String?
  breedCode   String?
  breedCustom String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@index([userId])
}
